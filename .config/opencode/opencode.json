{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".ai-agents/skills/bug-triage.md",
    ".ai-agents/skills/continual-improvement.md",
    ".ai-agents/skills/hontoni.md",
    ".ai-agents/skills/pre-flight.md",
    ".ai-agents/skills/release-readiness.md",
    ".ai-agents/rules/session-management.md",
    ".ai-agents/rules/agent-meta-protocol.md"
  ],
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-claude-auth"
  ],
    },
      "permission": { "edit": "deny", "bash": "deny" }
    }
  },
  "permission": {
    "read": "allow",
    "edit": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "ask",
      "./vendor/bin/sail pest *": "allow",
      "./vendor/bin/sail php artisan test *": "allow",
      "./vendor/bin/sail artisan test *": "allow",
      "./vendor/bin/sail pint *": "allow",
      "find *": "allow",
      "git branch --show-current": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git reset --hard *": "deny",
      "git clean -fd*": "deny",
      "sudo *": "deny",
      "rm -rf *": "deny",
      "chmod -R 777 *": "deny",
      "curl *|*sh": "deny",
      "curl *|*bash": "deny",
      "wget *|*sh": "deny",
      "wget *|*bash": "deny",
      "grep *": "ask",
      "ls *": "allow",
      "mkdir *": "allow",
      "date *": "allow"
    },
    "task": "allow",
    "skill": "allow",
    "lsp": "ask",
    "external_directory": "ask",
    "doom_loop": "ask"
  },
  "watcher": {
    "ignore": ["node_modules/**", "vendor/**"]
  }
}
