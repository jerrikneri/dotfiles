{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".ai-agents/skills/pre-flight.md",
    ".ai-agents/skills/teach-me.md",
    ".ai-agents/rules/session-management.md",
    ".ai-agents/rules/agent-meta-protocol.md"
  ],
  "plugin": [
    // "superpowers@git+https://github.com/obra/superpowers.git",
  ],
  "provider": {
    "mlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "omlx (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "apiKey": "{env:OMLX_API_KEY}"
      },
      "models": {
        "zai-org/glm-4.7-flash": {
          "name": "GLM-4.7-Flash (omlx)"
        },
        "qwen3.6-35b-a3b-mlx-4bit": {
          "name": "Qwen3.6-35B-A3B-MLX-4bit (omlx)"
        }
      }
    }
  },
  "permission": {
    "read": "allow",
    "edit": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "ask",
      "./vendor/bin/sail pest *": "allow",
      "./vendor/bin/sail php artisan test *": "allow",
      "./vendor/bin/sail artisan test *": "allow",
      "./vendor/bin/sail pint *": "allow",
      "find *": "allow",
      "git branch --show-current": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git reset --hard *": "deny",
      "git clean -fd*": "deny",
      "sudo *": "deny",
      "rm -rf *": "deny",
      "chmod -R 777 *": "deny",
      "curl *|*sh": "deny",
      "curl *|*bash": "deny",
      "wget *|*sh": "deny",
      "wget *|*bash": "deny",
      "grep *": "ask",
      "ls *": "allow",
      "mkdir *": "allow",
      "date *": "allow"
    },
    "task": "allow",
    "skill": "allow",
    "lsp": "ask",
    "external_directory": "ask",
    "doom_loop": "ask"
  },
  "watcher": {
    "ignore": ["node_modules/**", "vendor/**"]
  }
}
